# Copiez ce fichier en `.env` et renseignez vos valeurs.

# Clé API Anthropic (obligatoire pour l'analyse des photos).
# À défaut, vous pouvez vous authentifier via `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle de vision utilisé (optionnel).
# Options fréquentes : claude-opus-5 (par défaut), claude-sonnet-5 (moins cher).
VINTED_AI_MODEL=claude-opus-5

# Domaine Vinted à utiliser (optionnel).
VINTED_BASE_URL=https://www.vinted.fr

# Port de débogage distant de Chrome (optionnel).
VINTED_DEBUG_PORT=9222

# URL CDP du navigateur (optionnel, déduit du port par défaut).
# VINTED_CDP_URL=http://localhost:9222

# Répertoire de travail de l'assistant (optionnel).
# VINTED_AI_HOME=~/.vinted-assistant

# Mot de passe de l'interface web (INDISPENSABLE si tu l'exposes sur internet
# via un tunnel / un domaine). Sans valeur, l'app est accessible sans mot de passe.
# VINTED_WEB_PASSWORD=choisis-un-mot-de-passe-solide

# Secret de session (optionnel) : garde les sessions valides entre les
# redémarrages. Génère-le avec : python -c "import secrets; print(secrets.token_hex(32))"
# VINTED_WEB_SECRET=
